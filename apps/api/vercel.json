{
  "version": 2,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run vercel-build",
  "builds": [
    {
      "src": "api-entry.cjs",
      "use": "@vercel/node@13.0.2",
      "config": {
        "includeFiles": [
          "dist/vercel/source-manifest.json",
          "node_modules/@prisma/client/**",
          "node_modules/.prisma/client/**",
          "../../node_modules/@prisma/client/**",
          "../../node_modules/.prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api-entry.cjs"
    }
  ]
}
